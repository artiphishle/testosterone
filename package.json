{
  "name": "@ankhorage/test",
  "type": "module",
  "version": "0.3.9",
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsc",
    "prepack": "tsc",
    "test": "tsx --test test/self-tests.ts"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "types": "./dist/index.d.ts",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./cli": {
      "types": "./dist/cli/index.d.ts",
      "import": "./dist/cli/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "ankhorage-test": "./dist/cli/standalone.js"
  },
  "dependencies": {
    "c8": "^10.1.3",
    "glob": "^11.1.0",
    "jsdom": "^26.1.0",
    "tsx": "^4.23.13"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.20.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^5.9.3",
    "@ankhorage/ankh": "^0.11.1",
    "@ankhorage/contracts": "^22.8.102"
  },
  "description": "Suite-level TypeScript test platform and executable Ankh provider built on Node's native test runner.",
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://github.com/ankhorage/test#readme",
  "bugs": {
    "url": "https://github.com/ankhorage/test/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ankhorage/test.git"
  },
  "keywords": [
    "ankhorage",
    "test",
    "testing",
    "node-test",
    "typescript",
    "react",
    "jsdom",
    "cli"
  ],
  "ankh": {
    "category": "test",
    "provider": "./dist/cli/index.js",
    "capabilities": [
      "test.run"
    ]
  }
}
